# =============================================================================
# 670Send — environment template.
#   cp .env.example .env     (then fill in the CHANGE_ME values)
# NEVER commit .env. Generate every secret with:  openssl rand -base64 48
# In production these are injected by Docker/compose, not read from a file in git.
# =============================================================================

# ---- Runtime ------------------------------------------------------------------
NODE_ENV=development
# Business timezone (Timor-Leste, UTC+9, no DST). Used by cron jobs & waybill dates.
TZ=Asia/Dili
APP_TIMEZONE=Asia/Dili

# ---- Public URLs ----------------------------------------------------------------
WEB_URL=http://localhost:3100            # prod: https://670send.tl
PWA_URL=http://localhost:3101            # prod: https://app.670send.tl
ADMIN_URL=http://localhost:3102          # prod: https://admin.670send.tl
API_URL=http://localhost:4000            # prod: https://api.670send.tl
API_PORT=4000
# Number of reverse proxies in front of the API (Nginx = 1) so rate limits see the real client IP
TRUST_PROXY=0
# Comma-separated CORS allow-list (exact origins only, no wildcards in production)
CORS_ORIGINS=http://localhost:3100,http://localhost:3101,http://localhost:3102

# Browser-visible settings of the Next.js apps live in each app (apps/web/.env.local — see apps/web/.env.example).

# ---- i18n (Tetun is the strict default AND fallback) -------------------------------
DEFAULT_LOCALE=tet
FALLBACK_LOCALE=tet
SUPPORTED_LOCALES=tet,pt,en,id

# ---- PostgreSQL 17 (matches docker-compose.dev.yml) ---------------------------------
POSTGRES_USER=send670
POSTGRES_PASSWORD=send670_dev_only
POSTGRES_DB=send670
DATABASE_URL=postgresql://send670:send670_dev_only@localhost:55432/send670?schema=public
# prod example (internal Docker network host, strong password):
# DATABASE_URL=postgresql://send670:CHANGE_ME@postgres:5432/send670?schema=public&connection_limit=20

# ---- Redis 7 (BullMQ: WhatsApp queue, storage cron, settlement workers) ----------------
REDIS_URL=redis://localhost:16379
# prod: require a password and keep Redis on the internal network only
# REDIS_URL=redis://:CHANGE_ME@redis:6379

# ---- Auth / security -----------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_48_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_48_chars_different_from_access
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
# HMAC key for pickup OTP hashes. A 6-digit OTP hashed WITHOUT a secret can be brute-forced
# offline in milliseconds — never reuse another secret here, never rotate while OTPs are live.
OTP_PEPPER=CHANGE_ME_otp_pepper_min_48_chars
# AES-256-GCM key (base64 of 32 random bytes) for bank_account_details at rest:  openssl rand -base64 32
FIELD_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
# Argon2id tuning (defaults are fine for a 4 GB VPS; raise memory on bigger hosts)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# Lockout after repeated bad PIN / password attempts
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Rate limiting (requests per minute per IP) — public tracker & OTP endpoints are the hot spots
RATE_LIMIT_PUBLIC_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10

# ---- Object storage (S3-compatible: Cloudflare R2 or MinIO) ------------------------------
# Local dev uses the S3Mock container from docker-compose.dev.yml (any credentials work there).
S3_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=670send-private
S3_ACCESS_KEY_ID=dev_access_key
S3_SECRET_ACCESS_KEY=dev_secret_key
S3_FORCE_PATH_STYLE=true
# Signed URL lifetime for KYC / evidence photos (seconds). Buckets are PRIVATE — never public.
S3_SIGNED_URL_TTL_SECONDS=300
# Create the bucket on boot (dev / MinIO only — keep false in production)
S3_AUTO_CREATE_BUCKET=true
# Server-side cap per photo (clients compress to <200 KB first)
UPLOAD_MAX_BYTES=2097152
# Cloudflare R2 example:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false

# ---- WhatsApp (pluggable adapter) ---------------------------------------------------------
# console = sandbox logger (local dev) | meta | fonnte | waha
WHATSAPP_PROVIDER=console
# Jobs (WhatsApp, unclaimed sweep) run through Redis/BullMQ. false = run inline (tests only).
QUEUES_ENABLED=true
# Optional WhatsApp number that receives ops alerts (e.g. a parcel flagged return-to-sender)
OPS_ALERT_PHONE=
# Meta WhatsApp Cloud API — NOTE: business-initiated messages must use pre-approved templates.
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v22.0
META_WA_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_webhook_verify_token
# Fonnte
FONNTE_TOKEN=
# WAHA (self-hosted)
WAHA_BASE_URL=http://localhost:3010
WAHA_API_KEY=
WAHA_SESSION=default

# ---- Unclaimed-parcel cron ------------------------------------------------------------------
# Fixed by the SOP and registered with BullMQ on every boot: daily 08:00 Asia/Dili (+ hourly for perishables).

# ---- Seed (prisma/seed.ts) -----------------------------------------------------------------------
# Used ONLY by `pnpm db:seed`. In production, SEED_SUPERADMIN_PASSWORD is mandatory (>= 14 chars).
SEED_DEMO_DATA=true
SEED_FORCE_UPDATE=false
SEED_SUPERADMIN_EMAIL=superadmin@670send.test
SEED_SUPERADMIN_PHONE=+67077000001
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_superadmin_password
SEED_DEFAULT_PASSWORD=CHANGE_ME_demo_password
# 6-digit demo PIN for field users (must not be a weak PIN like 123456)
SEED_DEFAULT_PIN=482913

# ---- Backups (Phase 8) -------------------------------------------------------------------------
BACKUP_GPG_RECIPIENT=backup@zovoranexia.example
BACKUP_RCLONE_REMOTE=r2:670send-backups
BACKUP_RETENTION_DAYS=30

# ---- Observability (optional) ---------------------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=
