# Files that run on Linux must keep LF line endings even when checked out on Windows (CRLF breaks `#!/usr/bin/env bash`).
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
*.env.example   text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
docker-compose*.yml text eol=lf
.dockerignore   text eol=lf
