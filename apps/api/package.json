{
  "name": "@670send/api",
  "version": "0.2.0",
  "private": true,
  "description": "670Send backend (NestJS 11 + Prisma + PostgreSQL). Phase 2: auth, RBAC, i18n, audit, ledger, idempotency, uploads.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@670send/i18n": "workspace:*",
    "@670send/pricing": "workspace:*",
    "@670send/types": "workspace:*",
    "@670send/validation": "workspace:*",
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "~6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.5",
    "dotenv": "^17.2.0",
    "helmet": "^8.3.0",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.11.1",
    "nestjs-i18n": "^10.8.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "~6.19.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}
