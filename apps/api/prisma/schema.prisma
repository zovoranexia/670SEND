// =============================================================================
// 670Send — PostgreSQL schema (Prisma 6)
// Operated by Zovoranexia, Lda. — Timor-Leste inter-municipality logistics.
//
// Conventions
//  • Model/field names are camelCase in code, mapped to snake_case tables/columns.
//  • ALL money is NUMERIC(14,4) (Prisma Decimal). Never Float.
//  • All timestamps are timestamptz; the business timezone is Asia/Dili (UTC+9),
//    converted at the edges — never stored as local time.
//  • IDs are UUIDv7 (time-ordered) generated by Prisma.
//  • Soft delete (`deletedAt`) only on people / partner records. Shipments,
//    events, ledger and audit rows are NEVER deleted.
//  • IMMUTABLE tables (enforced by DB triggers in prisma/sql/001_*.sql):
//    ledger_entries, ledger_transactions, audit_logs, shipment_events.
//  • Extra CHECK constraints / triggers that Prisma cannot express live in
//    prisma/sql/001_integrity_and_immutability.sql and are appended to the
//    first migration (see apps/api/prisma/README.md).
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum LanguageCode {
  TET
  PT
  EN
  ID
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum RouteCorridor {
  LOCAL
  EAST
  SOUTH
  WEST
  SEA
}

enum HubType {
  TERMINAL
  PORT
  REGIONAL
}

enum VehicleType {
  BUS_PASSENGER
  PICKUP_CARGO
  TRUCK_CARGO
  SEA_FERRY
}

enum CourierVehicleType {
  MOTORBIKE
  PICKUP
}

enum PayoutCycle {
  DAILY
  WEEKLY
}

/// Channels a fleet OWNER can be paid through (MoU Art. 4 — never informal cash to a driver).
enum FleetPayoutChannel {
  BNCTL
  BNU
  MANDIRI
  BRI
  MOSAN
  TPAY
}

/// Channels an agent / courier can use to top up their deposit.
enum PaymentChannel {
  BNCTL
  BNU
  MANDIRI
  BRI
  MOSAN
  TPAY
  CASH
}

enum AddonServiceType {
  MOTOR_PICKUP
  MOTOR_DELIVERY
  CARGO_PICKUP
  CARGO_DELIVERY
}

enum ServiceScheme {
  SCHEME_A // AGENT_TO_AGENT   (primary MVP)
  SCHEME_B // PICKUP_TO_AGENT  (door-to-agent)
  SCHEME_C // AGENT_TO_DOOR
  SCHEME_D // DOOR_TO_DOOR     (premium)
}

enum TransportCanal {
  BUS_BAGGAGE
  CARGO_TRUCK_PICKUP
  SEA_FERRY_CARGO
}

enum IntakeChannel {
  AGENT_DROP_OFF // customer walked into a 670Link kiosk
  COURIER_PICKUP // motorbike / pickup courier collected at sender's address
  HUB_DESK // dropped at a company hub (no agent) — origin 15% goes to PLATFORM_HUB_OPS
}

enum IdType {
  BI
  KARTAUN_ELEITORAL
  PASSPORT
}

enum ItemCategory {
  DOCUMENT
  GENERAL
  CLOTHING
  ELECTRONICS
  LIQUID
  FOOD
  OTHER
}

/// 9-state tracking lifecycle (SOP §1.5).
enum ShipmentStatus {
  PICKUP_ASSIGNED
  DROPPED_AT_ORIGIN
  CONSOLIDATED_AT_HUB
  IN_TRANSIT
  ARRIVED_AT_DEST_AGENT
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD_ISSUE
  RETURN_TO_SENDER
}

enum PhotoType {
  OPEN_BOX_CONTENT
  SEALED_PARCEL
  BAGGAGE_PLACEMENT
  INBOUND_INCIDENT
  PROOF_OF_DELIVERY
  /// Bank / MOSAN / T-Pay slip or cash receipt for a deposit top-up request.
  DEPOSIT_PROOF
  /// Extra evidence added to a claim (customer photos, screenshots).
  CLAIM_EVIDENCE
}

enum PickupBookingStatus {
  REQUESTED
  ASSIGNED
  PICKED_UP
  CANCELLED
  EXPIRED
}

enum MasterBagStatus {
  OPEN
  SEALED
  DISPATCHED
  RECEIVED
  DISCREPANCY
}

enum ManifestStatus {
  DRAFT
  READY
  HANDED_OVER
  IN_TRANSIT
  ARRIVED
  COMPLETED
  DISCREPANCY
  CANCELLED
}

enum InboundCondition {
  INTACT
  DAMAGED_SEAL
  WET
  MISSING
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLAIM_FILED
}

enum WalletOwnerType {
  USER
  AGENT
  COURIER
  FLEET_OWNER
  SYSTEM
}

enum WalletType {
  DEPOSIT
  COMMISSION
  FLEET_PAYABLE
  COURIER_EARNINGS
  PLATFORM_REVENUE
  PLATFORM_HUB_OPS
  CLAIM_ESCROW_RESERVE
  INSURANCE_POOL
  /// SYSTEM holding wallet: fleet 40% + destination 15% until DELIVERED (see ARCHITECTURE.md §6).
  PENDING_SETTLEMENT
  /// SYSTEM counter-party for money crossing the system boundary (bank, cash, MOSAN/T-Pay).
  EXTERNAL_CLEARING
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerReferenceType {
  SHIPMENT_INTAKE
  ORIGIN_COMMISSION
  DEST_COMMISSION
  FLEET_SHARE
  COURIER_ADDON_SHARE
  ESCROW_ALLOCATION
  INSURANCE_PREMIUM
  STORAGE_PENALTY
  CLAIM_PAYOUT
  FLEET_PAYOUT
  DEPOSIT_TOPUP
  ADJUSTMENT
}

enum OriginShareMode {
  AGENT_CASH_RETAINED // agent keeps the 15% in cash; deposit debited by fee − 15%
  HUB_OPS // 15% credited to PLATFORM_HUB_OPS
}

enum SettlementStatus {
  HELD // intake booked, fleet/dest shares sit in PENDING_SETTLEMENT
  RELEASED // delivered: moved to FLEET_PAYABLE / destination COMMISSION
  REVERSED // shipment cancelled / refunded
}

enum DepositRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FleetPayoutStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  FAILED
  CANCELLED
}

enum PayoutItemKind {
  EARNING
  CLAIM_DEDUCTION
}

enum ClaimType {
  LOST
  DAMAGED
  SEAL_TAMPERED
}

enum ClaimStatus {
  OPEN
  INVESTIGATING
  APPROVED
  REJECTED
  PAID
}

enum LiableParty {
  FLEET_PARTNER
  ORIGIN_AGENT
  DEST_AGENT
  COURIER
  PLATFORM_ESCROW
}

enum NotificationEventCode {
  PICKUP_ASSIGNED
  DROPPED_AT_ORIGIN
  CONSOLIDATED_AT_HUB
  IN_TRANSIT
  ARRIVED_AT_DEST_AGENT
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD_ISSUE
  RETURN_TO_SENDER
  STORAGE_REMINDER_DAY3
  STORAGE_REMINDER_DAY5
}

enum NotificationAudience {
  SENDER
  RECIPIENT
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

// =============================================================================
// 1. AUTH & RBAC
// =============================================================================

model User {
  id                 String       @id @default(uuid(7)) @db.Uuid
  email              String?      @unique
  /// E.164, e.g. +67077123456. Login identifier for field users (phone + PIN).
  phone              String       @unique
  fullName           String       @map("full_name")
  /// Argon2id. Backoffice users (email + password).
  passwordHash       String?      @map("password_hash")
  /// Argon2id of the 6-digit transaction PIN (drop-off confirmation, field login).
  pinHash            String?      @map("pin_hash")
  preferredLang      LanguageCode @default(TET) @map("preferred_lang")
  isActive           Boolean      @default(true) @map("is_active")
  mustChangePassword Boolean      @default(false) @map("must_change_password")
  failedLoginCount   Int          @default(0) @map("failed_login_count")
  failedPinCount     Int          @default(0) @map("failed_pin_count")
  lockedUntil        DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?    @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?    @map("deleted_at") @db.Timestamptz(3)

  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  agent         Agent?
  courier       Courier?
  driver        Driver?
  fleetPartners FleetPartner[]  @relation("FleetOwner")
  auditLogs     AuditLog[]
  shipmentsMade Shipment[]      @relation("ShipmentCreatedBy")
  events        ShipmentEvent[]
  photos        ShipmentPhoto[]
  stagedUploads StagedUpload[]

  claimsFiled           Claim[]          @relation("ClaimFiledBy")
  claimsReviewed        Claim[]          @relation("ClaimReviewedBy")
  claimsFinanceApproved Claim[]          @relation("ClaimFinanceApprovedBy")
  depositsRequested     DepositRequest[] @relation("DepositRequestedBy")
  depositsReviewed      DepositRequest[] @relation("DepositReviewedBy")
  payoutsCreated        FleetPayout[]    @relation("PayoutCreatedBy")
  payoutsApproved       FleetPayout[]    @relation("PayoutApprovedBy")

  @@index([isActive, deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// SUPER_ADMIN | OPS_HUB_ADMIN | FINANCE_ADMIN | CS_CLAIMS_ADMIN | AGENT | COURIER | FLEET_OWNER | DRIVER (+ custom)
  key         String   @unique
  name        String
  description String?
  /// System roles cannot be deleted from the RBAC console.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// `module:action`, or the wildcard `*:*`.
  key         String  @unique
  module      String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  /// users.id of whoever granted the role (kept as a plain column on purpose).
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque token — the raw token is never stored.
  tokenHash    String    @unique @map("token_hash")
  /// Rotation family; reuse of a revoked token revokes the whole family.
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent")
  ip           String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// IMMUTABLE — UPDATE/DELETE are blocked by trigger.
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  /// Roles of the actor at the time (denormalised for forensic value).
  actorRoles String[] @map("actor_roles")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  /// Mandatory for SUPER_ADMIN force-overrides.
  reason     String?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Runtime-tunable business settings (bus capacity cap, claim threshold, storage policy, revenue split…).
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

/// Idempotency-Key store for financial / intake endpoints.
model IdempotencyKey {
  id           String            @id @default(uuid(7)) @db.Uuid
  key          String
  /// user id (or "anonymous") — keys are scoped per caller so one user cannot replay another's.
  scope        String
  method       String
  path         String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(IN_PROGRESS)
  responseCode Int?              @map("response_code")
  responseBody Json?             @map("response_body")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

// =============================================================================
// 2. GEOGRAPHY & HUBS
// =============================================================================

model Municipality {
  id                 String        @id @default(uuid(7)) @db.Uuid
  /// 3-letter waybill code: DIL BCU MAN VIQ LAU AIL AIN MFH COV LIQ ERM BOB ATA OEC
  code               String        @unique @db.VarChar(3)
  name               String
  mainTown           String        @map("main_town")
  corridor           RouteCorridor
  zoneId             String?       @map("zone_id") @db.Uuid
  /// Ataúro & Oecusse: land transit forbidden, SEA_FERRY_CARGO only.
  isSeaRoute         Boolean       @default(false) @map("is_sea_route")
  /// Added to the zone base rate (Oecusse +$2.00 makes Zone 4 span $6–$8).
  tariffSurchargeUsd Decimal       @default(0) @map("tariff_surcharge_usd") @db.Decimal(14, 4)
  /// Consolidation hub that serves this municipality (null for Díli itself).
  servingHubId       String?       @map("serving_hub_id") @db.Uuid
  isActive           Boolean       @default(true) @map("is_active")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  zone       PricingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  servingHub Hub?         @relation("HubServes", fields: [servingHubId], references: [id], onDelete: SetNull)

  hubsHere          Hub[]           @relation("HubLocation")
  agents            Agent[]
  couriers          Courier[]
  shipmentsOrigin   Shipment[]      @relation("ShipmentOrigin")
  shipmentsDest     Shipment[]      @relation("ShipmentDest")
  masterBags        MasterBag[]
  manifests         Manifest[]
  pickupBookingsDst PickupBooking[]

  @@index([corridor])
  @@index([zoneId])
  @@map("municipalities")
}

model Hub {
  id             String        @id @default(uuid(7)) @db.Uuid
  /// HUB_BECORA | HUB_TAIBESI | HUB_TASI_TOLU | HUB_DILI_PORT | …
  code           String        @unique
  name           String
  type           HubType
  corridor       RouteCorridor
  municipalityId String        @map("municipality_id") @db.Uuid
  address        String?
  lat            Decimal?      @db.Decimal(9, 6)
  lng            Decimal?      @db.Decimal(9, 6)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  municipality Municipality   @relation("HubLocation", fields: [municipalityId], references: [id], onDelete: Restrict)
  servesMunis  Municipality[] @relation("HubServes")
  couriers     Courier[]
  shipments    Shipment[]
  masterBags   MasterBag[]
  manifests    Manifest[]

  @@index([municipalityId])
  @@map("hubs")
}

// =============================================================================
// 3. PARTNERS & FIELD ACTORS
// =============================================================================

model Agent {
  id                     String        @id @default(uuid(7)) @db.Uuid
  userId                 String        @unique @map("user_id") @db.Uuid
  municipalityId         String        @map("municipality_id") @db.Uuid
  /// Human-friendly code, e.g. AG-DIL-001.
  agentCode              String        @unique @map("agent_code")
  kioskName              String        @map("kiosk_name")
  address                String
  lat                    Decimal?      @db.Decimal(9, 6)
  lng                    Decimal?      @db.Decimal(9, 6)
  /// Opening hours shown to recipients in the ARRIVED_AT_DEST_AGENT message.
  openingHours           String?       @map("opening_hours")
  hasDigitalScale        Boolean       @default(false) @map("has_digital_scale")
  hasSecureStorage       Boolean       @default(false) @map("has_secure_storage")
  adendumSignedAt        DateTime?     @map("adendum_signed_at") @db.Timestamptz(3)
  /// Link to the 670Link agent ecosystem (shared deposit balance / KYC).
  external670LinkAgentId String?       @unique @map("external_670link_agent_id")
  status                 PartnerStatus @default(PENDING)
  statusReason           String?       @map("status_reason")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt              DateTime?     @map("deleted_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  municipality    Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  shipmentsOrigin Shipment[]       @relation("ShipmentOriginAgent")
  shipmentsDest   Shipment[]       @relation("ShipmentDestAgent")
  depositRequests DepositRequest[]

  @@index([municipalityId, status])
  @@map("agents")
}

model FleetPartner {
  id                 String             @id @default(uuid(7)) @db.Uuid
  ownerUserId        String             @map("owner_user_id") @db.Uuid
  companyName        String             @map("company_name")
  serveRegNo         String?            @map("serve_reg_no")
  mouNumber          String?            @unique @map("mou_number")
  mouSignedAt        DateTime?          @map("mou_signed_at") @db.Date
  mouValidUntil      DateTime?          @map("mou_valid_until") @db.Date
  mouDocumentUrl     String?            @map("mou_document_url")
  mouAutoRenew       Boolean            @default(true) @map("mou_auto_renew")
  payoutCycle        PayoutCycle        @default(WEEKLY) @map("payout_cycle")
  payoutChannel      FleetPayoutChannel @map("payout_channel")
  /// Bank / MOSAN / T-Pay account details. Encrypt at application level (AES-256-GCM) before storing.
  bankAccountDetails Json?              @map("bank_account_details")
  status             PartnerStatus      @default(PENDING)
  statusReason       String?            @map("status_reason")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz(3)

  owner       User                 @relation("FleetOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  vehicles    Vehicle[]
  drivers     Driver[]
  manifests   Manifest[]
  settlements ShipmentSettlement[]
  payouts     FleetPayout[]

  @@index([ownerUserId])
  @@index([status, mouValidUntil])
  @@map("fleet_partners")
}

model Vehicle {
  id               String        @id @default(uuid(7)) @db.Uuid
  fleetPartnerId   String        @map("fleet_partner_id") @db.Uuid
  plateNumber      String        @unique @map("plate_number")
  vehicleType      VehicleType   @map("vehicle_type")
  routeCorridor    RouteCorridor @map("route_corridor")
  /// Safe baggage capacity for passenger buses (default cap = 20 small parcels, DNTT/PNTL safety).
  maxParcelSlots   Int           @default(20) @map("max_parcel_slots")
  dnttPermitNo     String?       @map("dntt_permit_no")
  dnttPermitExpiry DateTime?     @map("dntt_permit_expiry") @db.Date
  kirExpiry        DateTime?     @map("kir_expiry") @db.Date
  isActive         Boolean       @default(true) @map("is_active")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?     @map("deleted_at") @db.Timestamptz(3)

  fleetPartner FleetPartner @relation(fields: [fleetPartnerId], references: [id], onDelete: Restrict)
  manifests    Manifest[]

  @@index([fleetPartnerId, isActive])
  @@map("vehicles")
}

model Driver {
  id             String    @id @default(uuid(7)) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  fleetPartnerId String    @map("fleet_partner_id") @db.Uuid
  /// Karta Kondusaun (driving licence) number.
  licenseNumber  String    @map("license_number")
  licenseExpiry  DateTime? @map("license_expiry") @db.Date
  phone          String
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  fleetPartner FleetPartner      @relation(fields: [fleetPartnerId], references: [id], onDelete: Restrict)
  manifests    Manifest[]
  incidents    InboundIncident[]

  @@index([fleetPartnerId, isActive])
  @@map("drivers")
}

model Courier {
  id             String             @id @default(uuid(7)) @db.Uuid
  userId         String             @unique @map("user_id") @db.Uuid
  hubId          String?            @map("hub_id") @db.Uuid
  municipalityId String             @map("municipality_id") @db.Uuid
  vehicleType    CourierVehicleType @map("vehicle_type")
  plateNumber    String?            @map("plate_number")
  isAvailable    Boolean            @default(true) @map("is_available")
  status         PartnerStatus      @default(ACTIVE)
  lastSeenAt     DateTime?          @map("last_seen_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt      DateTime?          @map("deleted_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  hub             Hub?             @relation(fields: [hubId], references: [id], onDelete: SetNull)
  municipality    Municipality     @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  pickups         Shipment[]       @relation("ShipmentPickupCourier")
  deliveries      Shipment[]       @relation("ShipmentDeliveryCourier")
  pickupBookings  PickupBooking[]
  depositRequests DepositRequest[]

  @@index([municipalityId, isAvailable])
  @@map("couriers")
}

// =============================================================================
// 4. PRICING & LOCALIZED TARIFFS (admin-editable)
// =============================================================================

model PricingZone {
  id                 String   @id @default(uuid(7)) @db.Uuid
  /// ZONE_1 … ZONE_4
  code               String   @unique
  nameTet            String   @map("name_tet")
  namePt             String   @map("name_pt")
  nameEn             String   @map("name_en")
  nameId             String   @map("name_id")
  docRateUsd         Decimal  @map("doc_rate_usd") @db.Decimal(14, 4)
  smallBase2kgUsd    Decimal  @map("small_base_2kg_usd") @db.Decimal(14, 4)
  extraPerKgUsd      Decimal  @map("extra_per_kg_usd") @db.Decimal(14, 4)
  cargoBase10kgUsd   Decimal  @map("cargo_base_10kg_usd") @db.Decimal(14, 4)
  cargoExtraPerKgUsd Decimal  @map("cargo_extra_per_kg_usd") @db.Decimal(14, 4)
  etaTet             String   @map("eta_tet")
  etaPt              String   @map("eta_pt")
  etaEn              String   @map("eta_en")
  etaId              String   @map("eta_id")
  updatedBy          String?  @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  municipalities Municipality[]

  @@map("pricing_zones")
}

model AddonTariff {
  id                  String           @id @default(uuid(7)) @db.Uuid
  serviceType         AddonServiceType @unique @map("service_type")
  labelTet            String           @map("label_tet")
  labelPt             String           @map("label_pt")
  labelEn             String           @map("label_en")
  labelId             String           @map("label_id")
  feeUsd              Decimal          @map("fee_usd") @db.Decimal(14, 4)
  /// Courier / partner share, percent (80.00).
  courierSplitPct     Decimal          @map("courier_split_pct") @db.Decimal(5, 2)
  platformSplitPct    Decimal          @map("platform_split_pct") @db.Decimal(5, 2)
  maxWeightKg         Int?             @map("max_weight_kg")
  radiusKm            Int?             @map("radius_km")
  /// Wholesale rule: ≥ N parcels from one sender address → charge the add-on once.
  wholesaleMinParcels Int              @default(3) @map("wholesale_min_parcels")
  /// Admin toggle: wholesale pickups are free instead of single-charge.
  wholesaleFreePickup Boolean          @default(false) @map("wholesale_free_pickup")
  isActive            Boolean          @default(true) @map("is_active")
  updatedBy           String?          @map("updated_by") @db.Uuid
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("addon_tariffs")
}

// =============================================================================
// 5. CORE SHIPMENTS & TRACKING
// =============================================================================

model Shipment {
  id             String @id @default(uuid(7)) @db.Uuid
  /// 670S-[ORIG_3]-[DEST_3]-[YYMMDD]-[4_DIGIT_SEQ]
  waybillNumber  String @unique @map("waybill_number")
  idempotencyKey String @unique @map("idempotency_key")

  serviceScheme  ServiceScheme  @map("service_scheme")
  transportCanal TransportCanal @map("transport_canal")
  intakeChannel  IntakeChannel  @map("intake_channel")

  originMunicipalityId String  @map("origin_municipality_id") @db.Uuid
  destMunicipalityId   String  @map("dest_municipality_id") @db.Uuid
  originAgentId        String? @map("origin_agent_id") @db.Uuid
  destAgentId          String? @map("dest_agent_id") @db.Uuid
  originHubId          String? @map("origin_hub_id") @db.Uuid
  pickupCourierId      String? @map("pickup_courier_id") @db.Uuid
  deliveryCourierId    String? @map("delivery_courier_id") @db.Uuid
  pickupBookingId      String? @map("pickup_booking_id") @db.Uuid
  createdById          String  @map("created_by_id") @db.Uuid

  // ---- Sender (mandatory KYC) ------------------------------------------------
  senderName     String       @map("sender_name")
  senderIdType   IdType       @map("sender_id_type")
  senderIdNumber String       @map("sender_id_number")
  senderPhone    String       @map("sender_phone")
  senderLang     LanguageCode @default(TET) @map("sender_lang")
  senderAddress  String?      @map("sender_address")

  // ---- Recipient --------------------------------------------------------------
  recipientName    String       @map("recipient_name")
  recipientPhone   String       @map("recipient_phone")
  recipientLang    LanguageCode @default(TET) @map("recipient_lang")
  recipientAddress String?      @map("recipient_address")

  // ---- Contents & compliance gate ---------------------------------------------
  itemDescription       String       @map("item_description")
  itemCategory          ItemCategory @default(GENERAL) @map("item_category")
  isFragile             Boolean      @default(false) @map("is_fragile")
  isHeavyBulk           Boolean      @default(false) @map("is_heavy_bulk")
  /// Perishable food: unclaimed > 24h → RTS instead of 14 days.
  isShortShelfLife      Boolean      @default(false) @map("is_short_shelf_life")
  /// MUST be true — the API rejects intake otherwise.
  prohibitedCheckPassed Boolean      @map("prohibited_check_passed")
  /// Per-item confirmation recorded verbatim, e.g. {"narcotics":true,…}.
  prohibitedChecklist   Json         @map("prohibited_checklist")
  prohibitedCheckLang   LanguageCode @default(TET) @map("prohibited_check_lang")
  prohibitedCheckedAt   DateTime     @default(now()) @map("prohibited_checked_at") @db.Timestamptz(3)

  // ---- Value & insurance ------------------------------------------------------
  declaredValueUsd Decimal? @map("declared_value_usd") @db.Decimal(14, 4)
  isInsured        Boolean  @default(false) @map("is_insured")
  insuredAmountUsd Decimal? @map("insured_amount_usd") @db.Decimal(14, 4)
  insuranceFeeUsd  Decimal  @default(0) @map("insurance_fee_usd") @db.Decimal(14, 4)

  // ---- Weight & dimensions ----------------------------------------------------
  actualWeightKg     Decimal @map("actual_weight_kg") @db.Decimal(8, 3)
  lengthCm           Decimal @map("length_cm") @db.Decimal(7, 2)
  widthCm            Decimal @map("width_cm") @db.Decimal(7, 2)
  heightCm           Decimal @map("height_cm") @db.Decimal(7, 2)
  volumetricWeightKg Decimal @map("volumetric_weight_kg") @db.Decimal(8, 3)
  /// ceil(max(actual, volumetric)), minimum 1.
  chargeableWeightKg Int     @map("chargeable_weight_kg")
  isDocumentTier     Boolean @default(false) @map("is_document_tier")

  // ---- Fees (USD, NUMERIC(14,4)) ----------------------------------------------
  baseShippingFeeUsd  Decimal @default(0) @map("base_shipping_fee_usd") @db.Decimal(14, 4)
  pickupAddonFeeUsd   Decimal @default(0) @map("pickup_addon_fee_usd") @db.Decimal(14, 4)
  deliveryAddonFeeUsd Decimal @default(0) @map("delivery_addon_fee_usd") @db.Decimal(14, 4)
  storagePenaltyUsd   Decimal @default(0) @map("storage_penalty_usd") @db.Decimal(14, 4)
  totalFeeUsd         Decimal @default(0) @map("total_fee_usd") @db.Decimal(14, 4)
  /// Frozen copy of zone/tariff/split used at intake — disputes are settled against this, not today's tariff.
  pricingSnapshot     Json    @map("pricing_snapshot")

  // ---- Security / pickup OTP --------------------------------------------------
  sealCode             String?   @map("seal_code")
  /// HMAC-SHA256(OTP_PEPPER, shipmentId:otp). 6 digits is brute-forceable if hashed plainly.
  pickupOtpHash        String?   @map("pickup_otp_hash")
  pickupOtpExpiresAt   DateTime? @map("pickup_otp_expires_at") @db.Timestamptz(3)
  pickupOtpAttempts    Int       @default(0) @map("pickup_otp_attempts")
  pickupOtpLockedUntil DateTime? @map("pickup_otp_locked_until") @db.Timestamptz(3)

  // ---- Lifecycle --------------------------------------------------------------
  status                    ShipmentStatus
  /// Where to resume after an ON_HOLD_ISSUE is resolved.
  statusBeforeHold          ShipmentStatus? @map("status_before_hold")
  holdReason                String?         @map("hold_reason")
  arrivedDestAt             DateTime?       @map("arrived_dest_at") @db.Timestamptz(3)
  deliveredAt               DateTime?       @map("delivered_at") @db.Timestamptz(3)
  collectorName             String?         @map("collector_name")
  collectorIdType           IdType?         @map("collector_id_type")
  collectorIdNumber         String?         @map("collector_id_number")
  collectedByRepresentative Boolean         @default(false) @map("collected_by_representative")

  // ---- Unclaimed-parcel cron bookkeeping ---------------------------------------
  storageReminderDay3SentAt DateTime? @map("storage_reminder_day3_sent_at") @db.Timestamptz(3)
  storageReminderDay5SentAt DateTime? @map("storage_reminder_day5_sent_at") @db.Timestamptz(3)
  rtsFlaggedAt              DateTime? @map("rts_flagged_at") @db.Timestamptz(3)
  /// Return-to-sender leg: parcel physically back at the Dili hub, then handed to the sender.
  rtsReceivedAt             DateTime? @map("rts_received_at") @db.Timestamptz(3)
  rtsHandedBackAt           DateTime? @map("rts_handed_back_at") @db.Timestamptz(3)
  rtsCollectorName          String?   @map("rts_collector_name")
  rtsCollectorIdNumber      String?   @map("rts_collector_id_number")
  /// Failed last-mile delivery attempts (2 failures → parcel goes back to the destination agent).
  deliveryAttempts          Int       @default(0) @map("delivery_attempts")

  /// Optimistic-lock counter for status transitions.
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  originMunicipality Municipality   @relation("ShipmentOrigin", fields: [originMunicipalityId], references: [id], onDelete: Restrict)
  destMunicipality   Municipality   @relation("ShipmentDest", fields: [destMunicipalityId], references: [id], onDelete: Restrict)
  originAgent        Agent?         @relation("ShipmentOriginAgent", fields: [originAgentId], references: [id], onDelete: Restrict)
  destAgent          Agent?         @relation("ShipmentDestAgent", fields: [destAgentId], references: [id], onDelete: Restrict)
  originHub          Hub?           @relation(fields: [originHubId], references: [id], onDelete: SetNull)
  pickupCourier      Courier?       @relation("ShipmentPickupCourier", fields: [pickupCourierId], references: [id], onDelete: SetNull)
  deliveryCourier    Courier?       @relation("ShipmentDeliveryCourier", fields: [deliveryCourierId], references: [id], onDelete: SetNull)
  pickupBooking      PickupBooking? @relation(fields: [pickupBookingId], references: [id], onDelete: SetNull)
  createdBy          User           @relation("ShipmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  photos        ShipmentPhoto[]
  events        ShipmentEvent[]
  settlement    ShipmentSettlement?
  masterBagItem MasterBagItem?
  manifestItems ManifestItem[]
  incidents     InboundIncident[]
  claims        Claim[]
  notifications NotificationLog[]
  payoutItems   FleetPayoutItem[]

  @@index([status])
  @@index([destAgentId, status])
  @@index([originAgentId, createdAt])
  @@index([pickupCourierId, status])
  @@index([deliveryCourierId, status])
  @@index([status, arrivedDestAt])
  @@index([senderPhone])
  @@index([recipientPhone])
  @@index([originMunicipalityId, destMunicipalityId, createdAt])
  @@index([createdAt])
  @@map("shipments")
}

model ShipmentPhoto {
  id         String    @id @default(uuid(7)) @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  photoType  PhotoType @map("photo_type")
  /// PRIVATE object-storage URI (e.g. s3://bucket/key). Never public — served via short-lived signed URLs.
  fileUrl    String    @map("file_url")
  mimeType   String?   @map("mime_type")
  sizeBytes  Int?      @map("size_bytes")
  /// SHA-256 of the stored bytes — tamper evidence for claims.
  sha256     String?
  lat        Decimal?  @db.Decimal(9, 6)
  lng        Decimal?  @db.Decimal(9, 6)
  uploadedBy String    @map("uploaded_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  uploader User     @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([shipmentId, photoType])
  @@map("shipment_photos")
}

/// Photos uploaded BEFORE the shipment (and its waybill) exist. Intake consumes them:
/// the API refuses to create a waybill unless OPEN_BOX_CONTENT + SEALED_PARCEL uploads
/// owned by the acting user are attached. Unconsumed rows are garbage-collected by a worker.
model StagedUpload {
  id                   String    @id @default(uuid(7)) @db.Uuid
  uploadedBy           String    @map("uploaded_by") @db.Uuid
  photoType            PhotoType @map("photo_type")
  /// PRIVATE object-storage URI (s3://bucket/key).
  fileUrl              String    @map("file_url")
  mimeType             String    @map("mime_type")
  sizeBytes            Int       @map("size_bytes")
  sha256               String
  lat                  Decimal?  @db.Decimal(9, 6)
  lng                  Decimal?  @db.Decimal(9, 6)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(3)
  consumedByShipmentId String?   @map("consumed_by_shipment_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  uploader User @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([uploadedBy, createdAt])
  @@index([consumedAt, createdAt])
  @@map("staged_uploads")
}

/// IMMUTABLE timeline — UPDATE/DELETE are blocked by trigger.
model ShipmentEvent {
  id            String          @id @default(uuid(7)) @db.Uuid
  shipmentId    String          @map("shipment_id") @db.Uuid
  fromStatus    ShipmentStatus? @map("from_status")
  status        ShipmentStatus
  locationLabel String?         @map("location_label")
  notes         String?
  actorId       String?         @map("actor_id") @db.Uuid
  lat           Decimal?        @db.Decimal(9, 6)
  lng           Decimal?        @db.Decimal(9, 6)
  /// Extra structured context (manifest code, OTP-verified flag, override reason…). Never contains OTPs.
  meta          Json?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([shipmentId, createdAt])
  @@index([status, createdAt])
  @@map("shipment_events")
}

/// Online / WhatsApp pickup requests (Schemes B & D) before the courier performs on-site intake.
model PickupBooking {
  id                 String              @id @default(uuid(7)) @db.Uuid
  /// Groups ≥ N parcels from one address for the wholesale single-charge rule.
  batchCode          String              @unique @map("batch_code")
  senderName         String              @map("sender_name")
  senderPhone        String              @map("sender_phone")
  /// Free-form structured sender info captured by the public form.
  senderInfo         Json                @map("sender_info")
  preferredLang      LanguageCode        @default(TET) @map("preferred_lang")
  serviceScheme      ServiceScheme       @default(SCHEME_B) @map("service_scheme")
  destMunicipalityId String?             @map("dest_municipality_id") @db.Uuid
  parcelCount        Int                 @default(1) @map("parcel_count")
  estimatedWeightKg  Decimal?            @map("estimated_weight_kg") @db.Decimal(8, 3)
  pickupAddress      String              @map("pickup_address")
  lat                Decimal?            @db.Decimal(9, 6)
  lng                Decimal?            @db.Decimal(9, 6)
  notes              String?
  /// Public web bookings are only accepted after the phone is verified via WhatsApp OTP.
  phoneVerifiedAt    DateTime?           @map("phone_verified_at") @db.Timestamptz(3)
  assignedCourierId  String?             @map("assigned_courier_id") @db.Uuid
  assignedAt         DateTime?           @map("assigned_at") @db.Timestamptz(3)
  status             PickupBookingStatus @default(REQUESTED)
  cancelReason       String?             @map("cancel_reason")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  destMunicipality Municipality? @relation(fields: [destMunicipalityId], references: [id], onDelete: SetNull)
  assignedCourier  Courier?      @relation(fields: [assignedCourierId], references: [id], onDelete: SetNull)
  shipments        Shipment[]

  @@index([status, createdAt])
  @@index([assignedCourierId, status])
  @@map("pickup_bookings")
}

/// Per-(origin,dest,day) counter behind the waybill suffix. Incremented with
/// INSERT … ON CONFLICT DO UPDATE SET last_value = last_value + 1 RETURNING (atomic).
model WaybillSequence {
  originCode String   @map("origin_code") @db.VarChar(3)
  destCode   String   @map("dest_code") @db.VarChar(3)
  /// YYMMDD in Asia/Dili.
  dateKey    String   @map("date_key") @db.VarChar(6)
  lastValue  Int      @default(0) @map("last_value")
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([originCode, destCode, dateKey])
  @@map("waybill_sequences")
}

// =============================================================================
// 6. HUB CONSOLIDATION & FLEET MANIFESTS
// =============================================================================

model MasterBag {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// QR payload printed on the bag tag.
  bagCode            String          @unique @map("bag_code")
  plasticSealNumber  String?         @unique @map("plastic_seal_number")
  originHubId        String          @map("origin_hub_id") @db.Uuid
  destMunicipalityId String          @map("dest_municipality_id") @db.Uuid
  status             MasterBagStatus @default(OPEN)
  createdBy          String          @map("created_by") @db.Uuid
  sealedAt           DateTime?       @map("sealed_at") @db.Timestamptz(3)
  dispatchedAt       DateTime?       @map("dispatched_at") @db.Timestamptz(3)
  receivedAt         DateTime?       @map("received_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  originHub        Hub               @relation(fields: [originHubId], references: [id], onDelete: Restrict)
  destMunicipality Municipality      @relation(fields: [destMunicipalityId], references: [id], onDelete: Restrict)
  items            MasterBagItem[]
  manifestItems    ManifestItem[]
  incidents        InboundIncident[]

  @@index([originHubId, status])
  @@index([destMunicipalityId, status])
  @@map("master_bags")
}

/// A parcel can sit in at most one master bag at a time.
model MasterBagItem {
  masterBagId String   @map("master_bag_id") @db.Uuid
  shipmentId  String   @unique @map("shipment_id") @db.Uuid
  addedBy     String   @map("added_by") @db.Uuid
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  masterBag MasterBag @relation(fields: [masterBagId], references: [id], onDelete: Restrict)
  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@id([masterBagId, shipmentId])
  @@map("master_bag_items")
}

model Manifest {
  id                   String         @id @default(uuid(7)) @db.Uuid
  manifestCode         String         @unique @map("manifest_code")
  originHubId          String         @map("origin_hub_id") @db.Uuid
  destMunicipalityId   String         @map("dest_municipality_id") @db.Uuid
  transportCanal       TransportCanal @map("transport_canal")
  fleetPartnerId       String         @map("fleet_partner_id") @db.Uuid
  vehicleId            String         @map("vehicle_id") @db.Uuid
  driverId             String         @map("driver_id") @db.Uuid
  /// Required for SEA_FERRY_CARGO: official port cargo manifest number.
  portManifestNo       String?        @map("port_manifest_no")
  /// Proof parcels are in the closed baggage compartment (not aisle / unsafe roof load).
  baggagePhotoUrl      String?        @map("baggage_photo_url")
  parcelCount          Int            @default(0) @map("parcel_count")
  masterBagCount       Int            @default(0) @map("master_bag_count")
  scheduledDepartureAt DateTime?      @map("scheduled_departure_at") @db.Timestamptz(3)
  dispatchedAt         DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  arrivedAt            DateTime?      @map("arrived_at") @db.Timestamptz(3)
  status               ManifestStatus @default(DRAFT)
  createdBy            String         @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  originHub        Hub               @relation(fields: [originHubId], references: [id], onDelete: Restrict)
  destMunicipality Municipality      @relation(fields: [destMunicipalityId], references: [id], onDelete: Restrict)
  fleetPartner     FleetPartner      @relation(fields: [fleetPartnerId], references: [id], onDelete: Restrict)
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  driver           Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  items            ManifestItem[]
  incidents        InboundIncident[]

  @@index([fleetPartnerId, status])
  @@index([driverId, status])
  @@index([originHubId, destMunicipalityId, status])
  @@map("manifests")
}

/// Exactly ONE of masterBagId / shipmentId is set (CHECK in sql/001).
model ManifestItem {
  id               String            @id @default(uuid(7)) @db.Uuid
  manifestId       String            @map("manifest_id") @db.Uuid
  masterBagId      String?           @map("master_bag_id") @db.Uuid
  shipmentId       String?           @map("shipment_id") @db.Uuid
  inboundCondition InboundCondition? @map("inbound_condition")
  inboundAt        DateTime?         @map("inbound_at") @db.Timestamptz(3)
  inboundBy        String?           @map("inbound_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  manifest  Manifest   @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  masterBag MasterBag? @relation(fields: [masterBagId], references: [id], onDelete: Restrict)
  shipment  Shipment?  @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@unique([manifestId, masterBagId])
  @@unique([manifestId, shipmentId])
  @@index([shipmentId])
  @@index([masterBagId])
  @@map("manifest_items")
}

/// Destination-side damage / wet / missing report, confirmed digitally by the driver.
model InboundIncident {
  id                String           @id @default(uuid(7)) @db.Uuid
  shipmentId        String           @map("shipment_id") @db.Uuid
  manifestId        String?          @map("manifest_id") @db.Uuid
  masterBagId       String?          @map("master_bag_id") @db.Uuid
  condition         InboundCondition
  notes             String?
  reportedBy        String           @map("reported_by") @db.Uuid
  driverId          String?          @map("driver_id") @db.Uuid
  driverConfirmedAt DateTime?        @map("driver_confirmed_at") @db.Timestamptz(3)
  status            IncidentStatus   @default(OPEN)
  resolvedBy        String?          @map("resolved_by") @db.Uuid
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz(3)
  resolutionNotes   String?          @map("resolution_notes")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipment  Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  manifest  Manifest?  @relation(fields: [manifestId], references: [id], onDelete: SetNull)
  masterBag MasterBag? @relation(fields: [masterBagId], references: [id], onDelete: SetNull)
  driver    Driver?    @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status, createdAt])
  @@map("inbound_incidents")
}

// =============================================================================
// 7. FINANCIAL LEDGER, SETTLEMENTS, CLAIMS & NOTIFICATIONS
// =============================================================================

model Wallet {
  id            String          @id @default(uuid(7)) @db.Uuid
  ownerType     WalletOwnerType @map("owner_type")
  /// users.id / agents.id / couriers.id / fleet_partners.id — or the literal 'SYSTEM' for system wallets
  /// (a sentinel instead of NULL so the unique key below really is unique).
  ownerId       String          @map("owner_id")
  walletType    WalletType      @map("wallet_type")
  balance       Decimal         @default(0) @db.Decimal(14, 4)
  lockedBalance Decimal         @default(0) @map("locked_balance") @db.Decimal(14, 4)
  /// Incremented on every mutation (defence-in-depth next to SELECT … FOR UPDATE).
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@unique([ownerType, ownerId, walletType])
  @@index([walletType])
  @@map("wallets")
}

/// IMMUTABLE journal header: one row per business event. Its entries must net to zero (deferred trigger).
model LedgerTransaction {
  id             String              @id @default(uuid(7)) @db.Uuid
  referenceType  LedgerReferenceType @map("reference_type")
  referenceId    String?             @map("reference_id")
  /// Same Idempotency-Key replayed → same transaction, never a second posting.
  idempotencyKey String?             @unique @map("idempotency_key")
  description    String?
  metadata       Json?
  createdBy      String?             @map("created_by") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("ledger_transactions")
}

/// IMMUTABLE — UPDATE/DELETE blocked by trigger. `amount` is always positive; direction is `entryType`.
model LedgerEntry {
  id            String              @id @default(uuid(7)) @db.Uuid
  transactionId String              @map("transaction_id") @db.Uuid
  walletId      String              @map("wallet_id") @db.Uuid
  entryType     LedgerEntryType     @map("entry_type")
  referenceType LedgerReferenceType @map("reference_type")
  referenceId   String?             @map("reference_id")
  amount        Decimal             @db.Decimal(14, 4)
  balanceBefore Decimal             @map("balance_before") @db.Decimal(14, 4)
  balanceAfter  Decimal             @map("balance_after") @db.Decimal(14, 4)
  description   String?
  createdBy     String?             @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([transactionId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

/// Per-shipment money split (SOP §6.1) — the idempotent record that intake booked and delivery released.
model ShipmentSettlement {
  id                       String           @id @default(uuid(7)) @db.Uuid
  shipmentId               String           @unique @map("shipment_id") @db.Uuid
  fleetPartnerId           String?          @map("fleet_partner_id") @db.Uuid
  baseFeeUsd               Decimal          @map("base_fee_usd") @db.Decimal(14, 4)
  fleetShareUsd            Decimal          @map("fleet_share_usd") @db.Decimal(14, 4)
  platformShareUsd         Decimal          @map("platform_share_usd") @db.Decimal(14, 4)
  originShareUsd           Decimal          @map("origin_share_usd") @db.Decimal(14, 4)
  destShareUsd             Decimal          @map("dest_share_usd") @db.Decimal(14, 4)
  claimReserveUsd          Decimal          @map("claim_reserve_usd") @db.Decimal(14, 4)
  insuranceFeeUsd          Decimal          @default(0) @map("insurance_fee_usd") @db.Decimal(14, 4)
  /// Last-mile delivery add-on: courier's 80% (held in PENDING_SETTLEMENT until DELIVERED).
  courierShareUsd          Decimal          @default(0) @map("courier_share_usd") @db.Decimal(14, 4)
  /// Platform's 20% of the pickup + delivery add-ons (credited to PLATFORM_REVENUE at intake).
  addonPlatformUsd         Decimal          @default(0) @map("addon_platform_usd") @db.Decimal(14, 4)
  /// Pick-up add-on share the pickup courier keeps in cash (never enters the ledger).
  pickupCourierRetainedUsd Decimal          @default(0) @map("pickup_courier_retained_usd") @db.Decimal(14, 4)
  originMode               OriginShareMode  @map("origin_mode")
  /// HELD until BOTH parts are released: fleet share (intact arrival) and destination/courier shares (DELIVERED).
  status                   SettlementStatus @default(HELD)
  intakeLedgerTxnId        String?          @map("intake_ledger_txn_id") @db.Uuid
  fleetReleaseLedgerTxnId  String?          @map("fleet_release_ledger_txn_id") @db.Uuid
  fleetReleasedAt          DateTime?        @map("fleet_released_at") @db.Timestamptz(3)
  releaseLedgerTxnId       String?          @map("release_ledger_txn_id") @db.Uuid
  releasedAt               DateTime?        @map("released_at") @db.Timestamptz(3)
  /// Unused door-delivery add-on refunded to the customer (Finance, one-time).
  addonRefundedAt          DateTime?        @map("addon_refunded_at") @db.Timestamptz(3)
  addonRefundTxnId         String?          @map("addon_refund_txn_id") @db.Uuid
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipment     Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  fleetPartner FleetPartner? @relation(fields: [fleetPartnerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([fleetPartnerId, status])
  @@map("shipment_settlements")
}

model DepositRequest {
  id             String               @id @default(uuid(7)) @db.Uuid
  /// Exactly one of agentId / courierId (CHECK in sql/001).
  agentId        String?              @map("agent_id") @db.Uuid
  courierId      String?              @map("courier_id") @db.Uuid
  amountUsd      Decimal              @map("amount_usd") @db.Decimal(14, 4)
  channel        PaymentChannel
  /// Bank transfer reference / MOSAN or T-Pay transaction id / cash receipt no.
  referenceNo    String?              @map("reference_no")
  proofUrl       String?              @map("proof_url")
  note           String?
  status         DepositRequestStatus @default(PENDING)
  requestedBy    String               @map("requested_by") @db.Uuid
  reviewedBy     String?              @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime?            @map("reviewed_at") @db.Timestamptz(3)
  rejectReason   String?              @map("reject_reason")
  ledgerTxnId    String?              @map("ledger_txn_id") @db.Uuid
  idempotencyKey String               @unique @map("idempotency_key")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Restrict)
  courier   Courier? @relation(fields: [courierId], references: [id], onDelete: Restrict)
  requester User     @relation("DepositRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict)
  reviewer  User?    @relation("DepositReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([agentId, status])
  @@index([courierId, status])
  @@map("deposit_requests")
}

/// Batch payout to a Fleet OWNER (never to a driver).
model FleetPayout {
  id                String             @id @default(uuid(7)) @db.Uuid
  payoutNo          String             @unique @map("payout_no")
  fleetPartnerId    String             @map("fleet_partner_id") @db.Uuid
  periodStart       DateTime           @map("period_start") @db.Timestamptz(3)
  periodEnd         DateTime           @map("period_end") @db.Timestamptz(3)
  grossAmountUsd    Decimal            @map("gross_amount_usd") @db.Decimal(14, 4)
  /// Approved claims where the fleet was ruled liable, netted off automatically.
  claimDeductionUsd Decimal            @default(0) @map("claim_deduction_usd") @db.Decimal(14, 4)
  netAmountUsd      Decimal            @map("net_amount_usd") @db.Decimal(14, 4)
  channel           FleetPayoutChannel
  /// Bank / MOSAN / T-Pay transaction reference entered at disbursement.
  bankReference     String?            @map("bank_reference")
  statementUrl      String?            @map("statement_url")
  status            FleetPayoutStatus  @default(DRAFT)
  createdBy         String             @map("created_by") @db.Uuid
  approvedBy        String?            @map("approved_by") @db.Uuid
  approvedAt        DateTime?          @map("approved_at") @db.Timestamptz(3)
  paidAt            DateTime?          @map("paid_at") @db.Timestamptz(3)
  ledgerTxnId       String?            @map("ledger_txn_id") @db.Uuid
  paidBy            String?            @map("paid_by") @db.Uuid
  submittedAt       DateTime?          @map("submitted_at") @db.Timestamptz(3)
  failureReason     String?            @map("failure_reason")
  /// Created by the scheduled DAILY / WEEKLY generator (always lands as DRAFT for Finance to review).
  autoGenerated     Boolean            @default(false) @map("auto_generated")
  idempotencyKey    String             @unique @map("idempotency_key")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  fleetPartner    FleetPartner      @relation(fields: [fleetPartnerId], references: [id], onDelete: Restrict)
  creator         User              @relation("PayoutCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver        User?             @relation("PayoutApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict)
  items           FleetPayoutItem[]
  claimsRecovered Claim[]

  @@index([fleetPartnerId, status])
  @@index([status, createdAt])
  @@map("fleet_payouts")
}

model FleetPayoutItem {
  id          String         @id @default(uuid(7)) @db.Uuid
  payoutId    String         @map("payout_id") @db.Uuid
  /// A shipment can be paid out only once (unique over EARNING kind via partial index in sql/001).
  shipmentId  String         @map("shipment_id") @db.Uuid
  kind        PayoutItemKind
  amountUsd   Decimal        @map("amount_usd") @db.Decimal(14, 4)
  /// For CLAIM_DEDUCTION lines: the claim being recovered from the fleet.
  claimId     String?        @map("claim_id") @db.Uuid
  description String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  payout   FleetPayout @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  shipment Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Restrict)

  @@index([payoutId])
  @@index([shipmentId])
  @@index([claimId])
  @@map("fleet_payout_items")
}

model Claim {
  id                      String       @id @default(uuid(7)) @db.Uuid
  /// CLM-YYMMDD-NNNN
  claimNo                 String       @unique @map("claim_no")
  shipmentId              String       @map("shipment_id") @db.Uuid
  filedBy                 String       @map("filed_by") @db.Uuid
  claimType               ClaimType    @map("claim_type")
  description             String?
  claimantName            String?      @map("claimant_name")
  claimantPhone           String?      @map("claimant_phone")
  requestedAmountUsd      Decimal      @map("requested_amount_usd") @db.Decimal(14, 4)
  /// Auto-calculated by SOP rule: insured → min(declared, $500); uninsured → min(10× base fee, $50).
  maxEligibleLiabilityUsd Decimal      @map("max_eligible_liability_usd") @db.Decimal(14, 4)
  approvedAmountUsd       Decimal?     @map("approved_amount_usd") @db.Decimal(14, 4)
  liableParty             LiableParty? @map("liable_party")
  /// Photo / video evidence references (open-box, baggage, inbound incident, PoD, customer uploads).
  evidenceUrls            Json         @default("[]") @map("evidence_urls")
  status                  ClaimStatus  @default(OPEN)
  reviewedBy              String?      @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  /// Required when approvedAmount exceeds the CS threshold (system_settings.claim_cs_approval_limit_usd).
  financeApprovedBy       String?      @map("finance_approved_by") @db.Uuid
  financeApprovedAt       DateTime?    @map("finance_approved_at") @db.Timestamptz(3)
  rejectionReason         String?      @map("rejection_reason")
  payoutLedgerTxnId       String?      @map("payout_ledger_txn_id") @db.Uuid
  /// Cash receipt / transfer reference of the payment made to the customer.
  payoutReference         String?      @map("payout_reference")
  /// Insured claims are paid from the insurance pool first, any shortfall from the claim escrow reserve.
  paidFromInsuranceUsd    Decimal      @default(0) @map("paid_from_insurance_usd") @db.Decimal(14, 4)
  paidFromEscrowUsd       Decimal      @default(0) @map("paid_from_escrow_usd") @db.Decimal(14, 4)
  resolutionNotes         String?      @map("resolution_notes")
  /// Required reason when a claim is filed after the hand-over window (claims:approve holders only).
  lateFilingReason        String?      @map("late_filing_reason")
  paidAt                  DateTime?    @map("paid_at") @db.Timestamptz(3)
  /// Recovery from a liable fleet partner via payout deduction.
  recoveredInPayoutId     String?      @map("recovered_in_payout_id") @db.Uuid
  recoveredAmountUsd      Decimal      @default(0) @map("recovered_amount_usd") @db.Decimal(14, 4)
  createdAt               DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  shipment        Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  filer           User         @relation("ClaimFiledBy", fields: [filedBy], references: [id], onDelete: Restrict)
  reviewer        User?        @relation("ClaimReviewedBy", fields: [reviewedBy], references: [id], onDelete: Restrict)
  financeApprover User?        @relation("ClaimFinanceApprovedBy", fields: [financeApprovedBy], references: [id], onDelete: Restrict)
  recoveredPayout FleetPayout? @relation(fields: [recoveredInPayoutId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([status, createdAt])
  @@index([liableParty, status])
  @@map("claims")
}

model NotificationTemplate {
  id           String                @id @default(uuid(7)) @db.Uuid
  eventCode    NotificationEventCode @map("event_code")
  lang         LanguageCode
  /// {{variable}} placeholders; allowed variables per event are validated against NOTIFICATION_VARIABLES.
  bodyTemplate String                @map("body_template")
  isActive     Boolean               @default(true) @map("is_active")
  updatedBy    String?               @map("updated_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  logs NotificationLog[]

  @@unique([eventCode, lang])
  @@map("notification_templates")
}

model NotificationLog {
  id                String                     @id @default(uuid(7)) @db.Uuid
  shipmentId        String?                    @map("shipment_id") @db.Uuid
  audience          NotificationAudience
  recipientPhone    String                     @map("recipient_phone")
  eventCode         NotificationEventCode      @map("event_code")
  lang              LanguageCode
  templateId        String?                    @map("template_id") @db.Uuid
  /// OTP digits are MASKED (******) before storing — logs must never reveal a live pickup code.
  renderedBody      String                     @map("rendered_body")
  provider          String
  providerMessageId String?                    @map("provider_message_id")
  deliveryStatus    NotificationDeliveryStatus @default(QUEUED) @map("delivery_status")
  retryCount        Int                        @default(0) @map("retry_count")
  lastError         String?                    @map("last_error")
  /// e.g. `${shipmentId}:${eventCode}:${audience}` — a retried job can never send twice.
  dedupeKey         String?                    @unique @map("dedupe_key")
  queuedAt          DateTime                   @default(now()) @map("queued_at") @db.Timestamptz(3)
  sentAt            DateTime?                  @map("sent_at") @db.Timestamptz(3)
  deliveredAt       DateTime?                  @map("delivered_at") @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  shipment Shipment?             @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  template NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([shipmentId, eventCode])
  @@index([deliveryStatus, createdAt])
  @@index([recipientPhone])
  @@map("notification_logs")
}
