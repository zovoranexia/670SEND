# apps/web — public site (670send.tl). Copy to .env.local for development.
# Only NEXT_PUBLIC_* values are exposed to the browser; there are no secrets in this app.

# Public origin of THIS site (canonical URLs, sitemap, hreflang). Prod: https://670send.tl
NEXT_PUBLIC_WEB_URL=http://localhost:3100

# Public origin of the API (the browser calls it directly so per-IP rate limits apply to real visitors).
# It must be listed in the API's CORS_ORIGINS together with this site's origin. Prod: https://api.670send.tl
NEXT_PUBLIC_API_URL=http://localhost:4010

# Optional: WhatsApp support number in international format (digits only, e.g. 6707XXXXXXX). Hidden when empty.
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Map tiles for the pick-up pin. The default is the public OpenStreetMap server, which is fine for
# development and light traffic but must not carry production load — use your own or a paid provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
