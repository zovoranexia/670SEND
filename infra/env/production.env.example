# =============================================================================
# 670Send — PRODUCTION environment (one file, /opt/670send/.env, root:root, chmod 600).
#   cp infra/env/production.env.example /opt/670send/.env && chmod 600 /opt/670send/.env
# Fill every CHANGE_ME. The API refuses to start in production with a placeholder left in a secret, with
# WHATSAPP_PROVIDER=console, or with S3_AUTO_CREATE_BUCKET=true, so a forgotten value fails loudly at the first start.
# NEVER commit this file once filled. Keep an offline copy: losing FIELD_ENCRYPTION_KEY makes the stored fleet bank
# accounts unrecoverable (the nightly backup also contains an encrypted copy of this file).
# Generate secrets with:   openssl rand -hex 32        (URL-safe: required for the two passwords below)
#                          openssl rand -base64 32     (FIELD_ENCRYPTION_KEY)
# Do not leave optional variables set to an empty value: comment them out instead.
# =============================================================================

# ---- Public addresses (DNS A/AAAA records for all four must point at this server) -------------------
WEB_URL=https://670send.tl
PWA_URL=https://app.670send.tl
ADMIN_URL=https://admin.670send.tl
API_URL=https://api.670send.tl
# Exact origins allowed to call the API from a browser (no wildcards).
CORS_ORIGINS=https://670send.tl,https://app.670send.tl,https://admin.670send.tl

# ---- PostgreSQL / Redis (internal Docker network only) -----------------------------------------------
POSTGRES_USER=send670
POSTGRES_DB=send670
POSTGRES_PASSWORD=CHANGE_ME_hex_24_bytes
REDIS_PASSWORD=CHANGE_ME_hex_24_bytes

# ---- Secrets ---------------------------------------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME_hex_32_bytes
JWT_REFRESH_SECRET=CHANGE_ME_hex_32_bytes_different_from_access
# HMAC key of the pick-up OTP hashes. Never rotate while OTPs are live.
OTP_PEPPER=CHANGE_ME_hex_32_bytes
# AES-256-GCM key (base64 of 32 bytes) for the fleet bank accounts at rest.
FIELD_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# ---- Tuning (defaults are right for a 4 GB VPS) --------------------------------------------------------
LOG_LEVEL=info
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=14d
# ARGON2_MEMORY_KIB=65536
# RATE_LIMIT_PUBLIC_PER_MIN=60
# RATE_LIMIT_AUTH_PER_MIN=10

# ---- Object storage: Cloudflare R2 (PRIVATE bucket for photos and slips) ---------------------------------
S3_ENDPOINT=https://CHANGE_ME_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=670send-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false

# ---- WhatsApp: meta | fonnte | waha  (console is refused in production) ------------------------------------
WHATSAPP_PROVIDER=meta
# Meta Cloud API — business-initiated messages must use pre-approved templates.
META_WA_PHONE_NUMBER_ID=CHANGE_ME
META_WA_ACCESS_TOKEN=CHANGE_ME
# FONNTE_TOKEN=
# WAHA_BASE_URL=
# WAHA_API_KEY=
# OPS_ALERT_PHONE=+6707XXXXXXX

# ---- Public site extras (compiled into the web build) ----------------------------------------------------
# SUPPORT_WHATSAPP=6707XXXXXXX
# Production traffic must NOT use the public OpenStreetMap tile server: point this at your own / a paid tile provider.
# MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=© OpenStreetMap contributors

# ---- First start only: the bootstrap Super Admin created by `migrate` (>= 14 characters, never the default) ---
SEED_SUPERADMIN_EMAIL=CHANGE_ME@zovoranexia.example
SEED_SUPERADMIN_PHONE=+67033000000
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_at_least_14_characters
# The first sign-in forces a password change; remove nothing — the seed never overwrites an existing user.

# ---- Backups (read by infra/backup/*.sh) -------------------------------------------------------------------
# Public key(s) the backups are encrypted to. The PRIVATE key is NOT on this server (see docs/DEPLOYMENT.md §9).
BACKUP_GPG_RECIPIENT=backup@zovoranexia.example
# rclone remote and bucket/path, e.g. a SEPARATE R2 bucket (never the photo bucket):  r2backup:670send-backups
BACKUP_RCLONE_REMOTE=r2backup:670send-backups
BACKUP_RETENTION_DAYS=30
# Healthchecks.io-style URL pinged after each successful backup / restore drill (dead-man's switch). Optional.
# BACKUP_PING_URL=
# BACKUP_DRILL_PING_URL=
